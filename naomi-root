esphome:
  name: naomi-room
  friendly_name: Naomi Room
  
esp32:
  board: esp32-s3-devkitc-1
  framework:
    type: esp-idf

logger:

api:

ota:
  - platform: esphome

wifi:
  ssid: "xxx"
  password: "xxx"
  use_address: 192.168.x.x
  power_save_mode: none
  ap:
    ssid: "naomi-room-fallback"
    password: "12345678"

captive_portal:

safe_mode:

spi:
  clk_pin: GPIO48
  mosi_pin: GPIO47

output:
 - platform: ledc 
   pin: GPIO38 
   id: bl_pwm

light:
 - platform: monochromatic
   id: backlight
   output: bl_pwm
   restore_mode: ALWAYS_ON

display:
- platform: st7701s
  id: main_display
  dimensions: 480x480
  pclk_frequency: 12MHz
  cs_pin: GPIO39
  de_pin: GPIO18
  hsync_pin: GPIO16
  vsync_pin: GPIO17
  pclk_pin: GPIO21
  hsync_front_porch: 10
  hsync_pulse_width: 8
  hsync_back_porch: 50
  vsync_front_porch: 10
  vsync_pulse_width: 8
  vsync_back_porch: 20
  data_pins:
    red: [GPIO11, GPIO12, GPIO13, GPIO14, GPIO0]
    green: [GPIO8, GPIO20, GPIO3, GPIO46, GPIO9, GPIO10]
    blue: [GPIO4, GPIO5, GPIO6, GPIO7, GPIO15]
